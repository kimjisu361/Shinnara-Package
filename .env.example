# ==============================================================================
# 신나라패키지 (SINNARA PACKAGE) - 환경 변수 설정 템플릿 (.env.example)
# ==============================================================================
# 주의: 이 파일은 설정 가이드 템플릿입니다. 실제 비밀 키나 비밀번호를 여기에 직접 적지 마세요.
# 로컬 개발 시에는 이 파일을 복사하여 '.env' 파일을 만든 후 실제 값을 입력합니다.
# Netlify 배포 시에는 Netlify 대시보드(Site configuration > Environment variables)에 등록합니다.
# ==============================================================================

# [기본 시스템 환경 변수]
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# [1] 클라이언트 프론트엔드 환경 변수 (VITE_ 접두사 필수)
# 위치: 로컬 .env 및 Netlify 대시보드 (Build environment)
# 설명: Firebase 콘솔(프로젝트 설정 > 내 앱 > 웹 앱)에서 발급되는 공개 식별 정보입니다.
#       (클라이언트 공개 값이지만 보안은 Firestore Rules 및 Netlify 함수가 강제합니다)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="sinnara-package.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sinnara-package"
VITE_FIREBASE_STORAGE_BUCKET="sinnara-package.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# 관리자 허용 계정 (클라이언트 참고용)
VITE_ADMIN_ALLOWED_EMAIL="rlawltn2232@gmail.com"

# ------------------------------------------------------------------------------
# [2] 서버리스 전용 비공개 환경 변수 (VITE_ 접두사 절대 금지!)
# 위치: Netlify Dashboard (Site configuration > Environment variables)
# 설명: 브라우저 JavaScript 코드 번들에 절대 노출되면 안 되는 보안 시크릿입니다.
# ------------------------------------------------------------------------------
# 서버 측에서 Firebase ID 토큰을 검증할 때 사용하는 API 키
FIREBASE_API_KEY="AIzaSy..."

# 서버 측 관리자 인가 이메일 허용 목록 (서버 권한 검증에 사용)
ADMIN_ALLOWED_EMAIL="rlawltn2232@gmail.com"

# [참고: 3단계에서 사용할 Cloudinary 비공개 시크릿 - 사전 안내]
# CLOUDINARY_API_SECRET은 절대 프론트엔드에 노출하면 안 되며 오직 Netlify Functions에서만 읽습니다.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
